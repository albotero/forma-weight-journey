# Copy to .env and replace both required secrets with unique random values.
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-at-least-32-random-bytes
TIMEZONE=America/Bogota
STORAGE_PATH=./storage
PUBLIC_APP_URL=https://forma.albotero.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=mail.albotero.com
SMTP_PORT=587
SMTP_USERNAME=noreply-forma@albotero.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply-forma@albotero.com
SMTP_USE_SSL=false
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
CORS_ORIGINS=https://forma.albotero.com
APP_DOMAIN=forma.albotero.com
WEB_PORT=80
HTTPS_PORT=443
COOKIE_SECURE=true
